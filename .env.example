# Only the worker uses this key. Do not paste it into OMP chat.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Optional HTTP proxy for the official Jev API only; browser proxy is separate.
# QA_JEV_PROXY=http://127.0.0.1:1080
# Optional dedicated Chromium/Chrome binary. Never attach your daily profile.
# QA_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional saved authentication from a dedicated test account (sensitive local file).
# QA_STORAGE_STATE=/absolute/path/to/test-storage-state.json
# QA_NODE_PATH=node
# Comma-separated environment variable names whose values must be redacted.
# QA_REDACT_ENV=TEST_PASSWORD,APP_TOKEN
